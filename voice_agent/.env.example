# Copy to .env and fill in. Never commit .env.
JEV_API_KEY=
GROQ_API_KEY=
CARTESIA_API_KEY=
# Optional, for the provider comparison
CEREBRAS_API_KEY=
CEREBRAS_MODEL=

# Hosting only. See DEPLOY.md.
HF_TOKEN=
TURNIX_API_TOKEN=
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
ACCESS_PASSWORD=

# Decisions. Pin a specific version, not jev-latest.
JEV_MODEL=jev-1.14.0
# Use https://openrouter.ai/api and JEV_MODEL=typesafe/jev-1.14 if your key is an OpenRouter key.
JEV_BASE_URL=https://api.typesafe.ai
# one_call, two_call, or two_call_parallel
JEV_MODE=two_call

# Swappable modules
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
CLASSIFIER_MODEL=openai/gpt-oss-20b
TTS_PROVIDER=cartesia
TTS_MODEL=sonic-3.6-2026-08-27
TTS_VOICE=f786b574-daa5-4673-aa0c-cbe3e8534c02

# Decision thresholds. Starting values from TypeSafe's Noul docs.
THRESHOLD_NEEDS_HUMAN=0.7
THRESHOLD_ANSWERABLE=0.3
